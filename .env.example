# Copy this file to .env, then add your own key. Never commit .env.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Optional provider settings. Leave these blank unless switching LLM_PROVIDER.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
